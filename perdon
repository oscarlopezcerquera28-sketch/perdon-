<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Universo ❤️</title>

    <link rel="stylesheet" href="style.css">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
</head>

<body>

    <!-- Estrellas -->
    <div class="stars"></div>
    <div class="stars stars2"></div>
    <div class="stars stars3"></div>

    <!-- Contenido principal -->
    <main>

        <h1>TÚ ERES Y SERÁS<br>MI UNIVERSO</h1>

        <p class="subtitulo">
            Entre millones de estrellas,<br>
            siempre te elegiría a ti ❤️
        </p>

        <!-- Sistema de planetas -->
        <div class="universo">

            <div class="orbita orbita1"></div>
            <div class="orbita orbita2"></div>

            <div class="planeta planeta1"></div>
            <div class="planeta planeta2"></div>
            <div class="planeta planeta3"></div>

            <div class="sol"></div>

        </div>

        <!-- Frases -->
        <div class="frases">
            <span>Mi paz ✦</span>
            <span>Mi destino ✦</span>
            <span>Mi alegría ✦</span>
            <span>Por siempre ✦</span>
            <span>Mi universo ✦</span>
        </div>


        <!-- Tarjeta -->
        <section class="card">

            <div class="foto">
                <!-- Cambia esta URL por tu imagen -->
                <img src="https://placekitten.com/400/400" alt="Nuestro recuerdo">
            </div>

            <h2>Toca aquí, amor ❤️</h2>

            <button onclick="mostrarMensaje()">
                Presiona aquí
            </button>

        </section>

        <!-- Mensaje oculto -->
        <div id="mensaje" class="mensaje">
            ✨ Eres mi lugar favorito en todo el universo ✨
            <br><br>
            Gracias por existir ❤️
        </div>

    </main>


    <script>
        function mostrarMensaje() {
            const mensaje = document.getElementById("mensaje");

            mensaje.classList.toggle("mostrar");
        }
    </script>

</body>
</html>